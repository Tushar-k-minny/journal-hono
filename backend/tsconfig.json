{
     "compilerOptions": {
          "strict": true,
          "jsx": "react-jsx",
          "jsxImportSource": "hono/jsx",
          "strictNullChecks": true,
          "moduleResolution": "bundler",
          "module": "ESNext",
          "resolvePackageJsonImports": true,
          "types": [
               "bun"
          ],
          "rootDir": "src",
          "outDir": "dist",
          "paths": {
               "@auth/*": [
                    "./src/modules/auth/*"
               ],
               "@analytics/*": [
                    "./src/modules/analytics/*"
               ],
               "@journal/*": [
                    "./src/modules/journal/*"
               ],
               "@/*": [
                    "./src/*"
               ]
          }
     },
     "include": [
          "./src/**/*"
     ],
     "exclude": [
          "node_modules",
          "dist"
     ],
     "tsc-alias": {
          "resolveFullPaths": true
     }
}
